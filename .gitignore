# ===================================================================
#  Terra Nova — что НИКОГДА не попадает в репозиторий
#  Правило: код публикуем, доступы и персональные данные — нет.
# ===================================================================

# --- Секреты и доступы ---
private/
*.env
.env*
config.local.php
deploy.conf
deploy.sh
*.pem
*.key
id_rsa*

# --- Персональные данные и выгрузки из базы ---
*.sql
*.sqlite
*.db
exports/
backups/
dumps/

# --- Логи ---
*.log
logs/

# --- Системные файлы ---
.DS_Store
Thumbs.db
desktop.ini

# --- Редакторы ---
.vscode/
.idea/
*.swp
*~

# --- Временное ---
tmp/
temp/
node_modules/

# --- Исходники и рабочие файлы, не нужные в репозитории ---
*.zip
design/classes.txt
design/facts.txt
design/heads.txt
design/.thumbnail
